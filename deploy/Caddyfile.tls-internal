{
	default_sni {$COLP_TLS_SERVER_NAME}
}

{$COLP_SERVER_ORIGIN} {
	tls internal
	@proxied path /api/* /collections/* /.well-known/* /colp/* /health /ready
	handle @proxied {
		reverse_proxy server:3000 {
			header_up X-Forwarded-Proto https
		}
	}
	# The self-hosted build ships no sitemap or llms.txt (robots.txt disallows
	# all); without this the SPA fallback answers them 200 with index.html.
	@absent path /sitemap.xml /sitemap-*.xml /llms.txt /llms-full.txt
	handle @absent {
		respond 404
	}
	# Missing chunks must never become cacheable HTML at a CSS/JS URL.
	handle /assets/* {
		root * /srv/web
		file_server
	}
	handle {
		header Cache-Control "no-cache"
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
