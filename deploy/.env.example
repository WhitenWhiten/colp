# Public origin users enter in the extension and browser.
COLP_SERVER_ORIGIN=https://colp.example.test
# At least 32 random bytes, base64 encoded.
COLP_SERVER_SECRET=replace-with-32-byte-base64-secret
# PostgreSQL password used by the bundled database.
POSTGRES_PASSWORD=replace-me
# Image tag; the minor tag receives compatible patch releases.
COLP_IMAGE_TAG=0.1
# Set true only when the origin is an HTTP LAN/loopback endpoint.
COLP_INSECURE_HTTP=false
# Optional comma-separated extension IDs allowed by the server.
COLP_ALLOWED_EXTENSION_IDS=pplpnpegpnghcddhmpgkbfkdfadjiaen
POSTGRES_DB=colp
POSTGRES_USER=colp
