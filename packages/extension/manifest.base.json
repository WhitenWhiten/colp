{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extensionName__",
  "short_name": "__MSG_extensionShortName__",
  "description": "__MSG_extensionDescription__",
  "homepage_url": "https://know-n.com",
  "version": "0.1.0.5",
  "version_name": "0.1.0-rc.5",
  "minimum_chrome_version": "121",
  "key": "",
  "permissions": ["cookies", "storage", "unlimitedStorage", "alarms", "activeTab", "favicon", "contextMenus"],
  "optional_permissions": ["bookmarks", "tabs", "webNavigation", "scripting", "userScripts"],
  "host_permissions": ["__ENVIRONMENT_HOST_PERMISSIONS__"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "storage": { "managed_schema": "managed-storage-schema.json" },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+S" },
      "description": "__MSG_commandSavePage__"
    },
    "save-window-tabs": {
      "description": "__MSG_commandSaveWindowTabs__"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; img-src 'self' blob: data: https:"
  }
}
