{
  "name": "known",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "scan:dependencies": "npm audit --omit=dev --audit-level=high && npm audit --audit-level=high",
    "generate:agent-public": "node scripts/generate-agent-public.mjs",
    "generate:api-types": "node scripts/generate-openapi-types.mjs",
    "stamp:trust-spa": "node scripts/stamp-trust-spa-html.mjs",
    "prebuild": "npm run generate:agent-public",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && vite build && npm run stamp:trust-spa && node scripts/self-hosted-dist.mjs",
    "analyze": "vite build --mode analyze",
    "check:bundle-budget": "node scripts/check-bundle-budget.mjs",
    "lint": "eslint src --max-warnings 0",
    "lint:css": "stylelint \"src/**/*.css\" && node scripts/check-style-drift.mjs && node scripts/check-inline-styles.mjs && node scripts/check-dead-classes.mjs",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2",
    "web-vitals": "^5.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.20.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-vitest": "^0.5.4",
    "happy-dom": "^20.14.0",
    "openapi-typescript": "^7.13.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "stylelint": "^17.14.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "yaml": "^2.9.0"
  }
}
