{
  "name": "known",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "scan:dependencies": "npm audit --omit=dev --audit-level=high && npm audit --audit-level=high",
    "generate:agent-public": "node scripts/generate-agent-public.mjs",
    "stamp:trust-spa": "node scripts/stamp-trust-spa-html.mjs",
    "prebuild": "npm run generate:agent-public",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && vite build && npm run stamp:trust-spa",
    "analyze": "vite build --mode analyze",
    "check:bundle-budget": "node scripts/check-bundle-budget.mjs",
    "lint": "eslint src --max-warnings 0",
    "lint:css": "stylelint \"src/**/*.css\" && node scripts/check-style-drift.mjs && node scripts/check-inline-styles.mjs && node scripts/check-dead-classes.mjs",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:phase5:follow": "vitest run src/api/follow-boundary.test.ts src/api/followClient.test.ts src/lib/useFollowWorkflow.test.tsx src/pages/Profile.test.tsx src/pages/Collection.test.tsx",
    "test:phase5:feed": "vitest run src/api/feed-boundary.test.ts src/api/feedClient.test.ts src/lib/useProductFeed.test.tsx src/pages/Feed.test.tsx",
    "test:phase5:notifications": "vitest run src/api/notification-boundary.test.ts src/api/notificationClient.test.ts src/lib/useNotificationCenter.test.tsx src/pages/Notifications.test.tsx",
    "test:e2e:real-stack:feed": "node ../../Known-Backend/scripts/with-postgres.mjs -- node ../../Known-Backend/scripts/real-stack-e2e.mjs --grep P5-14",
    "test:e2e:real-stack:notifications": "node ../../Known-Backend/scripts/with-postgres.mjs -- node ../../Known-Backend/scripts/real-stack-e2e.mjs --grep P5-22",
    "test:e2e:real-stack:email": "node ../../Known-Backend/scripts/with-postgres.mjs -- node ../../Known-Backend/scripts/real-stack-e2e.mjs --grep P5-30",
    "test:e2e:real-stack:link-health": "node ../../Known-Backend/scripts/with-postgres.mjs -- node ../../Known-Backend/scripts/real-stack-e2e.mjs --grep LH-real-stack",
    "test:e2e:real-stack:free-social": "node ../../Known-Backend/scripts/with-postgres.mjs -- node ../../Known-Backend/scripts/real-stack-e2e.mjs --grep P5-",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:real-stack": "node ../../Known-Backend/scripts/with-postgres.mjs -- node ../../Known-Backend/scripts/real-stack-e2e.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2",
    "web-vitals": "^5.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "@vitejs/plugin-react": "^4.5.2",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.20.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-vitest": "^0.5.4",
    "happy-dom": "^20.14.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "stylelint": "^17.14.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
