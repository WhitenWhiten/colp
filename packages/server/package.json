{
  "name": "@know-n/colp-server",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "colp-server": "dist/src/cli/index.js"
  },
  "scripts": {
    "prebuild": "node scripts/write-version.mjs",
    "build": "node scripts/write-version.mjs && tsc -p tsconfig.json && esbuild migrations/*.ts --bundle --packages=external --outdir=dist/migrations --format=esm --platform=node --target=node22 --outbase=migrations --log-level=error",
    "dev": "tsx src/bootstrap/api.ts",
    "start": "node dist/src/bootstrap/self-hosted.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --ext .ts",
    "test": "npm run test:unit",
    "test:unit": "vitest run --project unit",
    "test:archive-memory": "vitest run --project unit tests/unit/ledger-archive/segment-payload-cache.test.ts",
    "test:system:inner": "vitest run --project system",
    "test:system": "node scripts/with-postgres.mjs -- npm run test:system:inner",
    "test:focused-coverage:inner": "vitest run --config vitest.focused-coverage.config.ts --coverage",
    "test:focused-coverage": "node scripts/with-postgres.mjs -- npm run test:focused-coverage:inner",
    "test:integration:inner": "vitest run --project postgres --fileParallelism=false --testTimeout=60000 --hookTimeout=120000 --exclude tests/integration/product/product-command-receipt.integration.test.ts --exclude tests/integration/phase4a/phase4a-p08-browser-postgres.integration.test.ts tests/integration",
    "test:integration": "node scripts/with-postgres.mjs -- npm run test:integration:inner",
    "test:integration:file": "node scripts/with-postgres.mjs -- node node_modules/vitest/vitest.mjs run --project postgres --fileParallelism=false --testTimeout=60000 --hookTimeout=120000",
    "db:migrate": "tsx src/infrastructure/database/migrate.ts",
    "scan:dependencies": "npm audit --audit-level=high",
    "evidence:phase3-extension-auth:logic": "vitest run tests/unit/phase3/phase3-extension-auth.test.ts",
    "check:imports": "node scripts/check-import-boundaries.mjs",
    "openapi:lint": "redocly lint openapi/colp-server-v1.yaml",
    "openapi:catalog": "node scripts/check-openapi-catalog.mjs",
    "openapi:examples": "node scripts/validate-openapi-examples.mjs --document openapi/colp-server-v1.yaml",
    "openapi:generate": "node scripts/generate-openapi.mjs",
    "openapi:drift": "node scripts/generate-openapi.mjs --check",
    "openapi:breaking": "node scripts/check-openapi-breaking.mjs",
    "openapi:ci": "npm run openapi:lint && npm run openapi:catalog && npm run openapi:examples && npm run openapi:drift && npm run openapi:breaking",
    "verify:phase5:contracts": "vitest run tests/unit/phase5/phase5-free-social-contract.test.ts",
    "verify:phase5:social-events": "vitest run tests/unit/phase5/phase5-social-event-contract.test.ts",
    "ci:focused-coverage": "npm run test:focused-coverage",
    "test:evidence:integration": "node scripts/with-postgres.mjs -- npm exec vitest run -- --fileParallelism=false tests/integration/phase0/phase0-exit-evidence.integration.test.ts tests/integration/postgres/postgres-editor-paging-evidence.integration.test.ts tests/integration/sync/sync-evidence-maintenance-postgres.integration.test.ts",
    "test:mcp:change-plan-store:unit:inner": "vitest run --fileParallelism=false --project unit tests/unit/mcp/mcp-change-plan-store.test.ts",
    "test:mcp:change-plan-store:unit": "npm run test:mcp:change-plan-store:unit:inner",
    "test:mcp:change-plan-store:postgres:inner": "vitest run --fileParallelism=false --project postgres tests/integration/postgres/postgres-mcp-change-plan-store.integration.test.ts",
    "test:mcp:change-plan-store:postgres": "node scripts/with-postgres.mjs -- npm run test:mcp:change-plan-store:postgres:inner",
    "test:mcp:change-plan-planner:unit:inner": "vitest run --fileParallelism=false --project unit tests/unit/phase4b/phase4b-mcp-change-plan-planner.test.ts",
    "test:mcp:change-plan-planner:unit": "npm run test:mcp:change-plan-planner:unit:inner",
    "test:mcp:change-plan-planner:postgres:inner": "vitest run --fileParallelism=false --project postgres tests/integration/postgres/postgres-phase4b-mcp-change-plan-planner.integration.test.ts",
    "test:mcp:change-plan-planner:postgres": "node scripts/with-postgres.mjs -- npm run test:mcp:change-plan-planner:postgres:inner",
    "test:mcp:change-plan-service:unit:inner": "vitest run --fileParallelism=false --project unit tests/unit/phase4b/phase4b-mcp-change-plan-service.test.ts",
    "test:mcp:change-plan-service:unit": "npm run test:mcp:change-plan-service:unit:inner",
    "test:mcp:change-plan-service:postgres:inner": "vitest run --fileParallelism=false --project postgres tests/integration/postgres/postgres-phase4b-mcp-change-plan-service.integration.test.ts",
    "test:mcp:change-plan-service:postgres": "node scripts/with-postgres.mjs -- npm run test:mcp:change-plan-service:postgres:inner",
    "test:mcp:change-plan-service": "npm run test:mcp:change-plan-service:unit && npm run test:mcp:change-plan-service:postgres",
    "test:mcp:write-operations:postgres:inner": "vitest run --fileParallelism=false --project postgres tests/integration/postgres/postgres-phase4b-mcp-write-operations.integration.test.ts",
    "test:mcp:write-operations:postgres": "node scripts/with-postgres.mjs -- npm run test:mcp:write-operations:postgres:inner",
    "test:redis-rate-limit": "vitest run --project redis tests/integration/redis/effect-page-admission-security.integration.test.ts",
    "test:acceptance:profiles": "node scripts/with-postgres.mjs --isolated-owner -- node node_modules/vitest/vitest.mjs run --project postgres --fileParallelism=false tests/integration/phase2/phase2-profile-conformance.integration.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1095.0",
    "@aws-sdk/s3-request-presigner": "3.1095.0",
    "@better-auth/cimd": "1.7.1",
    "@better-auth/kysely-adapter": "1.7.1",
    "@better-auth/mcp": "1.7.1",
    "@better-auth/oauth-provider": "1.7.1",
    "@know-n/colp": "0.1.1",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.3.1",
    "@mozilla/readability": "0.6.0",
    "@node-rs/argon2": "2.1.0",
    "@resvg/resvg-js": "^2.6.2",
    "better-auth": "1.7.1",
    "dotenv": "^16.4.7",
    "fast-uri": "3.1.6",
    "fastify": "5.12.3",
    "ioredis": "^6.0.0",
    "jose": "6.2.4",
    "kysely": "^0.29.4",
    "linkedom": "0.18.13",
    "luxon": "^3.7.2",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "rrule": "^2.8.1",
    "sanitize-html": "2.17.7",
    "satori": "^0.33.4",
    "tldts": "7.4.10"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@redocly/cli": "2.40.0",
    "@testcontainers/postgresql": "12.0.4",
    "@types/luxon": "^3.7.5",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "@vitest/coverage-v8": "3.2.7",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "^9.20.1",
    "fast-check": "^4.9.0",
    "openapi-typescript": "7.13.0",
    "playwright": "1.61.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6",
    "yaml": "2.9.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "@fastify/ajv-compiler": {
      "fast-uri": "3.1.6"
    },
    "fast-json-stringify": {
      "fast-uri": "4.1.4"
    },
    "js-yaml": "4.3.2",
    "minimatch": "10.2.5"
  }
}
