{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "documents", "cases"],
  "properties": {
    "$schema": { "const": "./search-quality-corpus.schema.json" },
    "version": { "const": "phase2b-search-quality-v1" },
    "documents": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resourceType", "resourceId", "collectionId", "title", "description", "url"],
        "properties": {
          "resourceType": { "enum": ["collection", "node"] },
          "resourceId": { "type": "string", "minLength": 1 },
          "collectionId": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "url": { "type": ["string", "null"] }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["query", "expectedTopN", "topN", "minimumRecall"],
        "properties": {
          "query": { "type": "string", "minLength": 1 },
          "expectedTopN": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "topN": { "type": "integer", "minimum": 1, "maximum": 20 },
          "minimumRecall": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
