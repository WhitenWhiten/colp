      { "eventType": "social.collection-change", "producerVersion": 2, "consumerVersions": [1, 2], "mode": "projection_latest_only", "owner": "social", "payloadRequired": ["collectionId", "ownerProfileId", "publicationRevision", "discoverabilityRecheckKey", "producerDiscoverability"], "nMinus1PayloadRequired": ["collectionId", "ownerProfileId", "publicationRevision", "discoverabilityRecheckKey"], "payloadProperties": { "collectionId": "opaque-id", "ownerProfileId": "profile-id", "publicationRevision": "non-empty-string", "discoverabilityRecheckKey": "non-empty-string", "producerDiscoverability": "public_candidate|remove" } },
      { "eventType": "social.feed-item-published", "producerVersion": 1, "consumerVersions": [1], "mode": "delivery_each_event", "owner": "notifications", "payloadRequired": ["feedItemId", "recipientProfileId", "sourceEventId", "collectionId", "discoverabilityRecheckKey"], "payloadProperties": { "feedItemId": "uuid", "recipientProfileId": "profile-id", "sourceEventId": "uuid", "collectionId": "uuid", "discoverabilityRecheckKey": "non-empty-string" } }
    ],
    "fixtures": { "current": "tests/fixtures/phase5/social-events.n.json", "previous": "tests/fixtures/phase5/social-events.n-minus-1.json" },
    "collectionChangeContract": {
      "eventType": "social.collection-change",
      "namespaceOwner": "product-social",
      "productEventIsColpFeedEvent": false,
      "producerVersion": 2,
      "consumerVersions": [1, 2],
      "handlerMode": "projection_latest_only",
      "maxPayloadBytes": 2048,
      "aggregate": { "aggregateType": "collection", "aggregateId": "payload.collectionId", "aggregateScope": "payload.collectionId", "aggregateRevision": "payload.publicationRevision" },
      "identities": { "eventId": "canonical-16-byte-base64url", "collectionId": "canonical-16-byte-base64url" },
      "ordering": { "watermarkScope": "aggregate_identity.aggregate_scope", "monotonicFact": "commit_ordinal", "comparison": "decimal-integer-greater-than", "opaqueRevisionComparable": false },
      "discoverability": { "recheckKeyFormat": "publication.collection:<collectionId>", "producerFacts": ["public_candidate", "remove"], "consumerMustRecheck": true, "publicCandidateMeaning": "eligible_for_current_authoritative_recheck_only", "removeMeaning": "deleted_or_not_publicly_discoverable_without_visibility_classification" },
      "payloadSchemas": {
        "1": ["collectionId", "discoverabilityRecheckKey", "ownerProfileId", "publicationRevision"],
        "2": ["collectionId", "discoverabilityRecheckKey", "ownerProfileId", "publicationRevision", "producerDiscoverability"]
      },
      "rollout": { "unknownPolicy": "fail-closed-replayable-not-completed", "expandOrder": ["deploy-consumer-1-and-2", "enable-producer-2", "drain-retained-version-1", "remove-consumer-1-later"] },
      "retentionRebuild": {
        "sourceEventTtlDays": 90,
        "feedItemTtlDays": 90,
        "unresolvedRowsPurgeable": false,
        "rebuildWindow": "retained-source-window-only",
        "authoritySources": ["retained-social.collection-change-events", "authoritative-follow-graph", "current-publication-discoverability"],
        "procedure": ["capture-per-scope-high-watermark", "replay-ascending-commit-ordinal", "dual-apply-live-events", "recheck-current-discoverability-before-write", "cas-watermark-with-projection", "cut-over-after-captured-watermarks"]
      },
