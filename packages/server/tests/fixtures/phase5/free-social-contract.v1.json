      { "method": "GET", "path": "/api/v1/me/feed", "operationId": "listMyFeed", "requestDto": "FeedPageQueryDto", "responseDto": "FeedPageDto", "errors": ["invalid_request", "authentication_required", "invalid_cursor", "rate_limited", "feature_temporarily_unavailable"] },
      { "method": "GET", "path": "/api/v1/me/notifications", "operationId": "listMyNotifications", "requestDto": "NotificationPageQueryDto", "responseDto": "NotificationPageDto", "errors": ["invalid_request", "authentication_required", "invalid_cursor", "rate_limited", "feature_temporarily_unavailable"] },
      { "method": "POST", "path": "/api/v1/me/notifications/read", "operationId": "markMyNotificationsRead", "requestDto": "MarkNotificationsReadRequestDto", "responseDto": "MarkNotificationsReadResultDto", "errors": ["invalid_request", "authentication_required", "csrf_failed", "resource_not_found", "command_id_reused", "command_in_progress", "command_result_expired", "rate_limited", "feature_temporarily_unavailable"] },
      { "method": "GET", "path": "/api/v1/me/notification-preferences", "operationId": "getMyNotificationPreferences", "requestDto": "EmptyQuery", "responseDto": "NotificationPreferencesDto", "errors": ["invalid_request", "authentication_required", "rate_limited", "feature_temporarily_unavailable"] },
      { "method": "PUT", "path": "/api/v1/me/notification-preferences", "operationId": "updateMyNotificationPreferences", "requestDto": "UpdateNotificationPreferencesRequestDto", "responseDto": "NotificationPreferencesDto", "errors": ["invalid_request", "authentication_required", "csrf_failed", "command_id_reused", "command_in_progress", "command_result_expired", "precondition_failed", "rate_limited", "feature_temporarily_unavailable"] }
    ],
    "dtoSchemas": {
      "ProfileSummaryDto": { "required": ["profileId", "handle", "displayName"], "properties": { "profileId": "profile-id", "handle": "string:1..64", "displayName": "string:1..120", "avatarUrl": "https-uri|null" } },
      "FollowRelationDto": { "required": ["actorProfileId", "targetProfileId", "following", "changedAt"], "properties": { "actorProfileId": "profile-id", "targetProfileId": "profile-id", "following": "boolean", "changedAt": "date-time" } },
      "FollowPageQueryDto": { "required": [], "properties": { "cursor": "opaque-string", "limit": "integer:1..100" } },
      "FollowPageDto": { "required": ["items", "nextCursor"], "properties": { "items": "ProfileSummaryDto[]", "nextCursor": "opaque-string|null" } },
      "FeedPageQueryDto": { "required": [], "properties": { "cursor": "opaque-string", "limit": "integer:1..100", "kind": "collection_change|follow_activity" } },
      "FeedItemDto": { "required": ["feedItemId", "kind", "actor", "collectionId", "publishedAt"], "properties": { "feedItemId": "uuid", "kind": "collection_change|follow_activity", "actor": "ProfileSummaryDto", "collectionId": "uuid|null", "publishedAt": "date-time" } },
      "FeedPageDto": { "required": ["items", "nextCursor"], "properties": { "items": "FeedItemDto[]", "nextCursor": "opaque-string|null" } },
      "NotificationPageQueryDto": { "required": [], "properties": { "cursor": "opaque-string", "limit": "integer:1..100", "read": "boolean" } },
      "NotificationDto": { "required": ["notificationId", "kind", "createdAt", "readAt", "actor", "collectionId"], "properties": { "notificationId": "uuid", "kind": "new_follower|followed_collection_changed", "createdAt": "date-time", "readAt": "date-time|null", "actor": "ProfileSummaryDto|null", "collectionId": "uuid|null" } },
      "NotificationPageDto": { "required": ["items", "nextCursor", "unreadCount"], "properties": { "items": "NotificationDto[]", "nextCursor": "opaque-string|null", "unreadCount": "integer:0..2147483647" } },
      "MarkNotificationsReadRequestDto": { "required": ["notificationIds"], "properties": { "notificationIds": "unique-uuid-array:1..100" } },
      "MarkNotificationsReadResultDto": { "required": ["notificationIds", "readAt"], "properties": { "notificationIds": "unique-uuid-array:1..100", "readAt": "date-time" } },
      "NotificationPreferencesDto": { "required": ["revision", "inAppNewFollower", "inAppFollowedCollectionChanged"], "properties": { "revision": "opaque-string", "inAppNewFollower": "boolean", "inAppFollowedCollectionChanged": "boolean" } },
      "UpdateNotificationPreferencesRequestDto": { "required": ["revision", "inAppNewFollower", "inAppFollowedCollectionChanged"], "properties": { "revision": "opaque-string", "inAppNewFollower": "boolean", "inAppFollowedCollectionChanged": "boolean" } }
    }
