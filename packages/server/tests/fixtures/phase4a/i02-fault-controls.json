{
  "schemaVersion": 5,
  "putResponseSamples": {
    "ok": [200, 201],
    "precondition": [412],
    "not_found": [404],
    "denied": [401, 403],
    "retryable": [408, 429, 500, 502, 503, 504],
    "unknown": [300, 400]
  },
  "transportErrorSamples": {
    "retryable": ["timeout", "abort"],
    "aborted": ["client_abort"],
    "unknown": ["network_error_after_request_sent"]
