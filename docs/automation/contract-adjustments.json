{
  "ConnectionProfileInput": {
    "removeRequired": [],
    "addProperties": {
      "authorizedClientId": {
        "description": "OAuth client identity: an opaque registration ID or an HTTPS CIMD metadata URL, without userinfo or a fragment. Preserve the exact authenticated identity.",
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9._~-]+$"
          },
          {
            "type": "string",
            "maxLength": 2048,
            "format": "uri",
            "pattern": "^[Hh][Tt][Tt][Pp][Ss]://[^\\s\\u0000-\\u001f\\u007f/@?#]+(?:[/?][^\\s\\u0000-\\u001f\\u007f#]*)?$"
          }
        ]
      }
    }
  },
  "ChangeInput": {
    "removeRequired": [
      "executionPolicyId"
    ],
    "addProperties": {
      "executionPolicyId": {
        "anyOf": [
          {
            "$ref": "#/$defs/OpaqueId"
          },
          {
            "type": "null"
          }
        ],
        "description": "Omit to preserve the existing execution policy; null explicitly removes it."
      }
    }
  },
  "Run": {
    "removeRequired": [],
    "addProperties": {
      "held": {
        "type": "boolean",
        "description": "Explicit per-run hold; global pause is reported separately by PauseState."
      },
      "explanation": {
        "type": "string",
        "maxLength": 1000,
        "description": "Bounded explanation of the pinned admission decision or latest execution outcome."
      },
      "usage": {
        "$ref": "#/$defs/RuleUsageView"
      },
      "childRunIds": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 128
        },
        "maxItems": 1000,
        "description": "Manual selection children, each with independent canonical effects and pinned task DAG."
      }
    }
  },
  "CompiledRule": {
    "removeRequired": [],
    "addProperties": {
      "definition": {
        "$ref": "#/$defs/RuleDefinition"
      }
    },
    "addRequired": [
      "definition"
    ]
  },
  "EffectReceiptView": {
    "removeRequired": [],
    "addProperties": {
      "versionId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "description": "Verified pre-commit collection version linked to the same plan; does not imply every field is undoable."
      }
    }
  },
  "PairingGrant": {
    "removeRequired": [],
    "addProperties": {
      "code": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 128
          },
          {
            "type": "null"
          }
        ],
        "description": "Returned once. Idempotent command replay returns null, matching existing credential issuance; issue a fresh grant if the initial response was lost."
      }
    }
  },
  "Job": {
    "removeRequired": [],
    "addProperties": {
      "resultId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "proposalDigest": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "planId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "explanation": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    }
  },
  "TaskInput": {
    "removeRequired": [],
    "addProperties": {
      "acceptedPredecessors": {
        "type": "array",
        "maxItems": 8,
        "items": {
          "type": "object",
          "properties": {
            "taskId": {
              "type": "string",
              "maxLength": 128
            },
            "resultId": {
              "type": "string",
              "maxLength": 128
            },
            "digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "output": {
              "$ref": "#/$defs/TaskOutput"
            }
          },
          "required": [
            "taskId",
            "resultId",
            "digest",
            "output"
          ],
          "additionalProperties": false
        },
        "description": "Accepted typed outputs from declared DAG predecessors, pinned once with their identity and digest."
      }
    }
  },
  "RuleUsageView": {
    "removeRequired": [],
    "addProperties": {
      "pendingJobs": {
        "type": "integer",
        "minimum": 0
      },
      "leasedJobs": {
        "type": "integer",
        "minimum": 0
      },
      "committingJobs": {
        "type": "integer",
        "minimum": 0
      },
      "policyBlockedJobs": {
        "type": "integer",
        "minimum": 0
      },
      "budgetBlockedJobs": {
        "type": "integer",
        "minimum": 0
      },
      "awaitingApprovalJobs": {
        "type": "integer",
        "minimum": 0
      },
      "uncertainJobs": {
        "type": "integer",
        "minimum": 0
      },
      "optionalCalls": {
        "type": "integer",
        "minimum": 0
      },
      "unknownCostCalls": {
        "type": "integer",
        "minimum": 0
      },
      "dailyRunLimit": {
        "type": "integer",
        "minimum": 0
      },
      "reservedRuns": {
        "type": "integer",
        "minimum": 0
      },
      "remainingRuns": {
        "type": "integer",
        "minimum": 0
      },
      "reportedCostMicros": {
        "type": "string",
        "pattern": "^[0-9]+$",
        "maxLength": 40,
        "description": "Sum of worker-reported observations in micros; not verified provider billing."
      },
      "budgetDay": {
        "type": "string",
        "format": "date"
      },
      "deliveryCapability": {
        "type": "string",
        "enum": [
          "unavailable",
          "available"
        ]
      },
      "acceptedDeliveries": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 0,
        "description": "Observed accepted callbacks only; never a count of completed jobs. Null when Events delivery is not enabled."
      }
    }
  },
  "PreviewInput": {
    "removeRequired": [],
    "addProperties": {
      "ruleId": {
        "$ref": "#/$defs/OpaqueId",
        "description": "Existing owned rule being edited; excluded by identity from competition and bound to activation."
      }
    }
  },
  "AgentSetupInput": {
    "schema": {
      "type": "object",
      "properties": {
        "definition": {
          "$ref": "#/$defs/RuleDefinition"
        },
        "bindings": {
          "$ref": "#/$defs/BindingSetInput"
        },
        "agent": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "clientId": {
              "description": "OAuth client identity: an opaque registration ID or an HTTPS CIMD metadata URL, without userinfo or a fragment. Preserve the exact authenticated identity.",
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[A-Za-z0-9._~-]+$"
                },
                {
                  "type": "string",
                  "maxLength": 2048,
                  "format": "uri",
                  "pattern": "^[Hh][Tt][Tt][Pp][Ss]://[^\\s\\u0000-\\u001f\\u007f/@?#]+(?:[/?][^\\s\\u0000-\\u001f\\u007f#]*)?$"
                }
              ]
            }
          },
          "required": [
            "name",
            "clientId"
          ],
          "additionalProperties": false
        },
        "targetId": {
          "$ref": "#/$defs/OpaqueId"
        },
        "wakeMode": {
          "type": "string",
          "enum": [
            "events",
            "poll"
          ]
        },
        "ruleId": {
          "$ref": "#/$defs/OpaqueId"
        },
        "ruleRevision": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "definition",
        "bindings"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "agent"
          ],
          "not": {
            "required": [
              "targetId"
            ]
          }
        },
        {
          "required": [
            "targetId"
          ],
          "not": {
            "required": [
              "agent"
            ]
          }
        }
      ],
      "dependentRequired": {
        "ruleId": [
          "ruleRevision"
        ],
        "ruleRevision": [
          "ruleId"
        ]
      }
    }
  },
  "AgentSetupResult": {
    "schema": {
      "type": "object",
      "properties": {
        "rule": {
          "$ref": "#/$defs/Rule"
        },
        "binding": {
          "$ref": "#/$defs/BindingSet"
        },
        "target": {
          "$ref": "#/$defs/Target"
        },
        "pairing": {
          "anyOf": [
            {
              "$ref": "#/$defs/PairingGrant"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "rule",
        "binding",
        "target",
        "pairing"
      ],
      "additionalProperties": false
    }
  },
  "RunOnceInput": {
    "removeRequired": [],
    "addProperties": {
      "nodeId": {
        "$ref": "#/$defs/OpaqueId",
        "description": "Optionally select exactly this bookmark within the authorized folder selection."
      },
      "tasksOnly": {
        "type": "boolean",
        "description": "Run agent tasks without changing bookmark placement. Requires tasks=all."
      }
    }
  }
}
