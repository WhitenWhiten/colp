{
  "apiVersion": "colp.automation/v1",
  "name": "Multi-assistant academic perspectives",
  "description": "Independent per-agent analyses of each batch of academic bookmarks (M4).",
  "roles": [
    {
      "key": "academicRoot",
      "kind": "folder",
      "required": true,
      "description": "Primary home for academic papers"
    },
    {
      "key": "researchEnricher",
      "kind": "executor",
      "required": true,
      "description": "Approved paper enrichment executor"
    }
  ],
  "on": "intake.completed",
  "scope": {
    "collectionId": "c_personal",
    "folderRole": "academicRoot",
    "includeDescendants": true
  },
  "match": {
    "kind": "field",
    "field": "bookmark.kind",
    "op": "eq",
    "value": "bookmark"
  },
  "trigger": {
    "mode": "countBatch",
    "count": 10,
    "distinctBy": "node",
    "partition": "rule"
  },
  "tasks": [
    {
      "id": "digest",
      "type": "digest.generate",
      "after": [],
      "executorRole": "researchEnricher",
      "required": true,
      "outputContract": "digest.sourced.v1",
      "inputFields": [
        "url",
        "title",
        "tags",
        "description"
      ],
      "instruction": "Append your own perspective with target attribution. Do not move or rename source bookmarks."
    }
  ],
  "route": {
    "mode": "broadcast",
    "execution": "perTarget",
    "audience": "optedInAuthorizedTargets"
  },
  "policy": {
    "history": "fromActivation",
    "imports": "exclude",
    "restores": "exclude",
    "userEdits": "preserve",
    "sameStageReentry": "deny",
    "maxHops": 8,
    "conflictingPlacement": "review",
    "privacy": "standard",
    "broadcastAllowed": true,
    "maxRunsPerDay": 100,
    "pauseMode": "stopAdmissionHoldPending",
    "missingInput": "defer"
  },
  "priority": 100
}
